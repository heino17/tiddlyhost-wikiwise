# Tiddlyhost-Wikiwise – Endanwender-Installation (HTTP)
#
#   cp .env.example .env    # Domain/Port eintragen
#   ./install.sh
#
# Voraussetzungen: Docker + Docker Compose v2.
# TLS kommt in einer späteren Version dazu (siehe README.md).

# Domain bzw. IP, unter der die Installation erreichbar ist.
# Für einen lokalen Test reicht "localhost".
DOMAIN=tiddlyhost.local

# Port, auf dem der Webserver antwortet (80/443 brauchen Root-Rechte).
HTTP_PORT=8080

# Image, das gestartet wird. Sobald die CI-Pipeline läuft, ist das ein
# GHCR-Pull; für einen Test ohne Registry einen lokal gebauten Tag eintragen.
TIDDLHOST_IMAGE=ghcr.io/heino17/tiddlyhost-wikiwise:latest

# Werden beim ersten Aufruf von install.sh automatisch erzeugt und danach
# in .env festgeschrieben. Nur manuell ändern, wenn noch keine Nutzer
# existieren – sonst sind alle bestehenden Sessions ungültig.
#SECRET_KEY_BASE=
#DB_PASSWORD=
