# Tiddlyhost-Wikiwise – Endanwender-Installation
#
#   cp .env.example .env    # Domain/Port eintragen
#   ./install.sh
#
# Voraussetzungen: Docker + Docker Compose v2.
#
# HTTPS/TLS:
#   - Ohne weitere Einstellungen läuft die Installation nach wie vor rein über HTTP.
#   - Für echten Internet-Betrieb mit Let's Encrypt kannst du entweder
#       (a) ./install.sh --tls --letsencrypt --admin-email ... ausführen (Caddy
#           holt dann automatisch ein Zertifikat), oder
#       (b) Zertifikate selbst ablegen (siehe deploy/README.md) und TLS aktivieren.
#   - Für tiddlyhost.local ist auch ein selbstsigniertes Zertifikat nutzbar.
#
# Domain bzw. IP, unter der die Installation erreichbar ist.
# Für einen lokalen Test reicht "localhost" bzw. "tiddlyhost.local".
DOMAIN=tiddlyhost.local

# Port, auf dem der Webserver antwortet (80/443 brauchen Root-Rechte).
HTTP_PORT=8080

# HTTP(S)-Port für den Reverse-Proxy.
# Bei TLS mit Caddy werden i.d.R. 80 und 443 verwendet (siehe README).
# Nur setzen, wenn du bewusst von den Defaults abweichst.
#HTTPS_PORT=443

# Image, das gestartet wird.
TIDDLHOST_IMAGE=ghcr.io/heino17/tiddlyhost-wikiwise:latest

# TLS-Einstellungen
# TLS_ENABLED=true aktiviert Caddy als Reverse-Proxy mit HTTPS.
# TLS_ENABLED=false (Default) nutzt den bisherigen Nginx-HTTP-Proxy.
TLS_ENABLED=false

# Für Let's Encrypt (nur relevant wenn TLS_ENABLED=true und CADDY_LETSENCRYPT=true)
# Caddy benötigt eine gültige E-Mail für Benachrichtigungen und ACME.
#ACME_EMAIL=

# CADDY_LETSENCRYPT=true lässt Caddy Zertifikate über Let's Encrypt holen.
# CADDY_LETSENCRYPT=false erwartet eigene Zertifikate in ./certs/ (fullchain.pem, privkey.pem)
# oder nutzt vorhandene Zertifikate.
CADDY_LETSENCRYPT=false

# Werden beim ersten Aufruf von install.sh automatisch erzeugt und danach
# in .env festgeschrieben. Nur manuell ändern, wenn noch keine Nutzer
# existieren – sonst sind alle bestehenden Sessions ungültig.
#SECRET_KEY_BASE=
#DB_PASSWORD=
