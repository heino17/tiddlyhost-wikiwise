{$DOMAIN} {
	header_up Host {host}
	header_up X-Real-IP {remote}
	header_up X-Forwarded-For {remote}
	header_up X-Forwarded-Proto {scheme}

	@simple path /simplewiki/*
	handle @simple {
		reverse_proxy app:3333 {
			header_up X-Forwarded-Proto {scheme}
		}
		encode off
	}

	reverse_proxy app:3333 {
		header_up X-Forwarded-Proto {scheme}
	}
}

# Caddy holt automatisch Let's Encrypt-Zertifikate für {$DOMAIN}
