- if site.thumbnail.present?
  %button.thumbnail-preview-trigger{ type: 'button',
    title: t('site_view_thumbnail_preview_open'),
    aria: { label: t('site_view_thumbnail_preview_alt', name: site.name) },
    data: thumbnail_preview_data(site, site.thumbnail) }
    = bi_icon('image', height: '0.9em', fill: 'var(--bs-link-color)')
